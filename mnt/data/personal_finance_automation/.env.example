# Plaid credentials
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_secret_here

# Plaid environment
# Use "sandbox" while testing.
# Change to "production" after your Plaid application is approved.
PLAID_ENV=sandbox

# Accounts / products
PLAID_COUNTRY_CODES=US
PLAID_PRODUCTS=transactions

# Local user identifier
PLAID_CLIENT_USER_ID=personal-finance-local-user

# Local web app
PORT=8000

# File locations
EXCEL_PATH=./Personal_Financial_Model_V2.xlsx
DB_PATH=./data/finance.db
